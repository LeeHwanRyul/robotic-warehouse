-def _sample_cardinal_offsets(
-    sensor_range: int,
-    rng: np.random.Generator,
-) -> List[Tuple[int, int]]:
-    if sensor_range <= 0:
-        return [(0, 0)]
-    offsets = [(0, 1), (1, 0), (0, -1), (-1, 0)]
-    rng.shuffle(offsets)
-    return offsets
