-        if completed_returns
-        else float("nan"),
-        "episode_length": float(np.mean(completed_lengths))
-        if completed_lengths
-        else float("nan"),
-        "team_events": float(np.mean(completed_team_events))
-        if completed_team_events
-        else float("nan"),
-        "episodes": float(len(completed_returns)),
