-                rollout,
-                agent_id,
-                cfg.sequence_length,
-                cfg.minibatch_chunks,
-                rng,
-            ):
-                adv_seq = torch.stack(
-                    [
-                        agent_adv[s : s + cfg.sequence_length]
-                        for s in mb_starts
