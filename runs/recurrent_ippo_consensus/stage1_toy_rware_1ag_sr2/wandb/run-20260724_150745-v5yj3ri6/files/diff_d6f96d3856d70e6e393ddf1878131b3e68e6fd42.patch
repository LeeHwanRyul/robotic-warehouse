-def _sensor_location_index(sensor_range: int, dy: int, dx: int) -> Optional[int]:
-    if abs(dy) > sensor_range or abs(dx) > sensor_range:
-        return None
-    width = 1 + 2 * sensor_range
-    return int((dy + sensor_range) * width + (dx + sensor_range))
