+def oracle_weight_matrix(env: gym.Env, n_agents: int) -> np.ndarray:
+    clusters = oracle_clusters(env)
+    weights = np.zeros((n_agents, n_agents), dtype=np.float32)
+    if not clusters:
+        return weights
+    for cluster in clusters:
+        for i in cluster:
+            for j in cluster:
+                if i != j:
+                    weights[int(i), int(j)] = 1.0
+    return weights
+
